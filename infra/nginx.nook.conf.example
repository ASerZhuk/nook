# Сайт nook для nginx на хосте (VPS рядом с другими сайтами).
# 1. Скопировать в /etc/nginx/sites-available/nook, заменить nook.example.ru на свой поддомен,
#    включить: ln -s /etc/nginx/sites-available/nook /etc/nginx/sites-enabled/nook
# 2. nginx -t && systemctl reload nginx
# 3. Сертификат: certbot --nginx -d nook.example.ru  (добавит listen 443 ssl и редирект с http)
server {
    listen 80;
    listen [::]:80;
    server_name nook.example.ru;

    client_max_body_size 12m; # аватарки до 10 МБ

    # API напрямую, минуя Next.js
    location /api/ {
        proxy_pass http://127.0.0.1:8100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s; # вход по звонку и ИИ-разбор быстрой записи отвечают дольше обычного
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
