APP_DOMAIN=nook.example.ru
JWT_SECRET=change-me-long-random-string
COOKIE_SECURE=true
TIMEZONE=Europe/Moscow
# smsint Call Password (вход по звонку); пусто — dev-режим (код показывается на экране входа)
SMSINT_API_TOKEN=
VAPID_SUBJECT=mailto:you@example.ru
# Быстрая запись одной строкой (OpenAI-совместимый API)
VSELLM_BASE_URL=https://api.vsellm.ru/v1
VSELLM_TOKEN=
VSELLM_MODEL=openai/gpt-5.4-nano
# Необязательно: если не заданы, ключи сгенерируются в /data/vapid.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
